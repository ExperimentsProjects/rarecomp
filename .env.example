# Required: hosted PostgreSQL (Neon, Supabase, or Vercel Postgres)
# Never use localhost / 127.0.0.1 on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required for customer accounts and login activity
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/experiments_projects?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=experiments_projects

# Required before enabling live payments in Admin → Settings
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Required for product-image uploads on Vercel.
# Created automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# Optional first-owner recovery defaults
ADMIN_BOOTSTRAP_EMAIL=your-admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
